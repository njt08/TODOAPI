@Host = http://localhost
@Port = 3000
@Server = {{Host}}:{{Port}}


//---------------------------------------------------- 1


### GET all tasks
GET {{Server}}/api/tasks
Content-Type: application/json


//---------------------------------------------------- 2


### GET a task by ID
GET {{Server}}/api/tasks/1
content-Type: application/json


//---------------------------------------------------- 3


### POST a new task
POST {{Server}}/api/tasks
Content-Type: application/json

{
    "title": "New Task",
    "description": "This is a new task",
    "deadline": "pending"
}


//---------------------------------------------------- 4


### PATCH a task by ID
PATCH {{Server}}/api/tasks/1
Content-Type: application/json

{
    "title": "Updated Task",
    "description": "This task has been updated",
    "deadline": "2026-12-31",
    "completed": true
}


//---------------------------------------------------- 5


### DELETE a task by ID
DELETE {{Server}}/api/tasks/1
Content-Type: application/json


//---------------------------------------------------- 6


### DLETE all tasks
DELETE {{Server}}/api/tasks
Content-Type: application/json


